# Copy to .env on the server. chmod 600 .env. Never commit .env.
APP_DOMAIN=sweep.alorasupports.com

# Secrets (same names the desktop tool keeps in Keychain / Credential Manager)
ALORA_EVV_PORTAL_USERNAME=
ALORA_EVV_PORTAL_PASSWORD=
ALORA_EVV_GOOGLE_CLIENT_ID=
ALORA_EVV_GOOGLE_CLIENT_SECRET=
# Any long random string, e.g. from:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ALORA_EVV_WEB_SESSION_SECRET=
